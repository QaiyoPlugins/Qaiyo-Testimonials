msgid "V1 — Horizontal rows"
msgstr "V1 — Horizontale Reihen"

msgid "1 or 2 rows scrolling left/right with fading edges."
msgstr "1 oder 2 Reihen, links/rechts scrollend, mit verblassenden Rändern."

msgid "V2 — Vertical columns"
msgstr "V2 — Vertikale Spalten"

msgid "2 or 3 columns scrolling up/down with fading edges."
msgstr "2 oder 3 Spalten, hoch/runter scrollend, mit verblassenden Rändern."

msgid "V3 — Photo carousel"
msgstr "V3 — Foto-Karussell"

msgid "Single row, large photo on top of each card."
msgstr "Eine Reihe, großes Foto oben auf jeder Karte."

msgid "V4 — Bento grid"
msgstr "V4 — Bento-Grid"

msgid "Asymmetric grid with one highlighted box."
msgstr "Asymmetrisches Raster mit einer hervorgehobenen Box."

msgid "V5 — Avatar switcher"
msgstr "V5 — Avatar-Umschalter"

msgid "Click an avatar to reveal the matching quote (max 29)."
msgstr "Klicke einen Avatar, um das Zitat anzuzeigen (max. 29)."

msgid "V6 — Photo hero card"
msgstr "V6 — Foto-Hero-Karte"

msgid "Large photo at the top of each card, dark content section below."
msgstr "Großes Foto oben auf jeder Karte, dunkler Inhaltsbereich darunter."

msgid "V7 — Pastel tilted cards"
msgstr "V7 — Pastellfarbene, geneigte Karten"

msgid "Slightly rotated cards in pastel colors (set per testimonial)."
msgstr "Leicht gedrehte Karten in Pastellfarben (pro Kundenstimme einstellbar)."

msgid "V8 — Split panel hero"
msgstr "V8 — Geteilte Hero-Karte"

msgid "Wide hero card: quote on the left, photo + name on the right."
msgstr "Breite Hero-Karte: Zitat links, Foto + Name rechts."

msgid "Photo on top, dark content card."
msgstr "Foto oben, dunkle Inhaltskarte."

msgid "Slightly rotated colored cards."
msgstr "Leicht gedrehte farbige Karten."

msgid "Wide split: quote left, photo + name right."
msgstr "Breite Teilung: Zitat links, Foto + Name rechts."

msgid "V7 uses the per-testimonial background and text color from the \"V4 Highlight\" meta box on each Testimonial — set them there to give each card its own pastel color."
msgstr "V7 nutzt die individuellen Hintergrund- und Textfarben aus der \"Karten-Farben\"-Meta-Box jeder Kundenstimme."

msgid "Author box colors (V8 right panel)"
msgstr "Autor-Box-Farben (V8 rechtes Panel)"

msgid "Author box background"
msgstr "Autor-Box-Hintergrund"

msgid "Author box text color"
msgstr "Autor-Box-Textfarbe"

msgid "Description box uses the global \"Card background\" and \"Quote / description text\" colors from the design overrides below."
msgstr "Die Beschreibungs-Box nutzt die globalen Farben \"Karten-Hintergrund\" und \"Zitat-/Beschreibungstext\" aus den Design-Überschreibungen unten."

msgid "Description box colors (V8 left panel)"
msgstr "Beschreibungs-Box-Farben (V8 linkes Panel)"

