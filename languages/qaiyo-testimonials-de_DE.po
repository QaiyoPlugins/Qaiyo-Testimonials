msgstr "Stil 2 — Fetter Block"

msgid "Style 3 — Calligraphic comma"
msgstr "Stil 3 — Kalligrafisches Komma"

msgid "Style 4 — Speech-bubble outline"
msgstr "Stil 4 — Sprechblase-Kontur"

