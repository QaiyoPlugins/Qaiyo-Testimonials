msgstr "A megjelenítés mentve, használható."

msgid "Save the display first to get a shortcode."
msgstr "Először mentsd a megjelenítést a shortcode-hoz."

msgid "Paste this shortcode anywhere on your site:"
msgstr "Másold be ezt a shortcode-ot bárhova az oldaladon:"

msgid "Click to select, then copy."
msgstr "Kattints a kijelöléshez, majd másold."

msgid "1. Choose layout version"
msgstr "1. Válassz elrendezés verziót"

msgid "2. Quote mark style"
msgstr "2. Idézőjel stílus"

msgid "3. Content source"
msgstr "3. Tartalom forrás"

msgid "4. Layout-specific options"
msgstr "4. Verzió-specifikus opciók"

msgid "5. Design overrides (optional)"
msgstr "5. Design felülírás (opcionális)"

msgid "V1 — Horizontal rows"
msgstr "V1 — Vízszintes sorok"

msgid "1 or 2 rows scrolling left/right with fading edges."
msgstr "1 vagy 2 sor balra/jobbra gördülve, elhalványuló szélekkel."

msgid "V2 — Vertical columns"
msgstr "V2 — Függőleges oszlopok"

msgid "2 or 3 columns scrolling up/down with fading edges."
msgstr "2 vagy 3 oszlop fel/le gördülve, elhalványuló szélekkel."

msgid "V3 — Photo carousel"
msgstr "V3 — Fotó körhinta"

msgid "Single row, large photo on top of each card."
msgstr "Egy sor, nagy fotó minden kártya tetején."

msgid "V4 — Bento grid"
msgstr "V4 — Bento rács"

msgid "Asymmetric grid with one highlighted box."
msgstr "Aszimmetrikus rács egy kiemelt dobozzal."

msgid "V5 — Avatar switcher"
msgstr "V5 — Avatár váltó"

msgid "Click an avatar to reveal the matching quote (max 29)."
msgstr "Kattints egy avatárra a véleményéért (max. 29)."

msgid "V6 — Photo hero card"
msgstr "V6 — Fotós hero kártya"

msgid "Large photo at the top of each card, dark content section below."
msgstr "Nagy fotó minden kártya tetején, alatta sötét tartalom szekció."

msgid "V7 — Pastel tilted cards"
msgstr "V7 — Pasztel ferde kártyák"

msgid "Slightly rotated cards in pastel colors (set per testimonial)."
msgstr "Enyhén elforgatott pasztel színű kártyák (testimonialonként állítható)."

msgid "V8 — Split panel hero"
msgstr "V8 — Osztott hero panel"

msgid "Wide hero card: quote on the left, photo + name on the right."
msgstr "Széles hero kártya: idézet balra, fotó + név jobbra."

msgid "Photo on top, dark content card."
msgstr "Fotó felül, sötét tartalom kártya."

msgid "Slightly rotated colored cards."
msgstr "Enyhén elforgatott színes kártyák."

msgid "Wide split: quote left, photo + name right."
msgstr "Széles osztás: idézet balra, fotó + név jobbra."

msgid "V7 uses the per-testimonial background and text color from the \"V4 Highlight\" meta box on each Testimonial — set them there to give each card its own pastel color."
msgstr "A V7 minden testimonial saját háttér- és szövegszínét használja a \"Kártya színek\" meta box-ból — ott állítsd be, hogy minden kártya saját pasztel színt kapjon."

msgid "Author box colors (V8 right panel)"
msgstr "Szerző box színei (V8 jobb panel)"

msgid "Author box background"
msgstr "Szerző box háttér"

msgid "Author box text color"
msgstr "Szerző box szövegszín"

msgid "Description box uses the global \"Card background\" and \"Quote / description text\" colors from the design overrides below."
msgstr "A leírás box az alábbi design felülírások \"Kártya háttér\" és \"Idézet / leírás szöveg\" színeit használja."

msgid "Description box colors (V8 left panel)"
msgstr "Leírás box színei (V8 bal panel)"

msgid "Description box background"
msgstr "Leírás box háttér"

msgid "Description box text color"
msgstr "Leírás box szövegszín"

msgid "Right column ratio: photo gets 2/3, author panel gets 1/3 vertically."
msgstr "Jobb oszlop arány: a fotó 2/3-ot, a szerző panel 1/3-ot kap függőlegesen."

msgid "left description box"
msgstr "bal leírás box"

msgid "right author box"
msgstr "jobb szerző box"

msgid "Which testimonial to display"
msgstr "Melyik vélemény jelenjen meg"

msgid "— First in selected category —"
msgstr "— A kiválasztott kategória első eleme —"

msgid "V8 is designed to feature a single testimonial. Pick which one — leave empty to use the first from the selected category."
msgstr "A V8 egyetlen vélemény kiemelésére optimális. Válaszd ki melyiket — üresen hagyva a kiválasztott kategória első eleme jelenik meg."

msgid "Card colors (V4 highlight, V7 background)"
msgstr "Kártya színek (V4 kiemelés, V7 háttér)"

msgid "Used by V4 (only when highlighted above) and V7 (always — each card uses its own background and text color)."
msgstr "V4 használja (csak ha kiemelt) és V7 mindig — minden kártyához saját háttér- és szövegszín."

msgid "Style 1 — Teardrop \"66\""
msgstr "1. stílus — Csepp \"66\""

msgid "Style 2 — Bold block"
msgstr "2. stílus — Tömör blokk"

msgid "Style 3 — Calligraphic comma"
msgstr "3. stílus — Kalligráfikus vessző"

msgid "Style 4 — Speech-bubble outline"
msgstr "4. stílus — Buborék körvonal"

msgid "Limit"
msgstr "Korlát"

msgid "New testimonials added to this category will appear automatically."
msgstr "A kategóriához hozzáadott új vélemények automatikusan megjelennek."

msgid "-1 = no limit. V5 always caps at 29."
msgstr "-1 = nincs korlát. A V5 mindig max. 29."

msgid "Rows"
msgstr "Sorok"

msgid "Columns"
msgstr "Oszlopok"

msgid "Direction"
msgstr "Irány"

msgid "Left"
msgstr "Balra"

msgid "Right"
msgstr "Jobbra"

msgid "Up"
msgstr "Fel"

msgid "Down"
msgstr "Le"

