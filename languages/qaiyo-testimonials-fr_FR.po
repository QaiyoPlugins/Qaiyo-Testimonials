msgstr "5. Surcharges de design (optionnel)"

msgid "V1 — Horizontal rows"
msgstr "V1 — Lignes horizontales"

msgid "1 or 2 rows scrolling left/right with fading edges."
msgstr "1 ou 2 lignes défilant à gauche/droite avec bords estompés."

msgid "V2 — Vertical columns"
msgstr "V2 — Colonnes verticales"

msgid "2 or 3 columns scrolling up/down with fading edges."
msgstr "2 ou 3 colonnes défilant en haut/bas avec bords estompés."

msgid "V3 — Photo carousel"
msgstr "V3 — Carrousel photo"

msgid "Single row, large photo on top of each card."
msgstr "Une ligne, grande photo en haut de chaque carte."

msgid "V4 — Bento grid"
msgstr "V4 — Grille bento"

msgid "Asymmetric grid with one highlighted box."
msgstr "Grille asymétrique avec une boîte mise en avant."

msgid "V5 — Avatar switcher"
msgstr "V5 — Sélecteur d’avatars"

msgid "Click an avatar to reveal the matching quote (max 29)."
msgstr "Cliquez un avatar pour révéler le témoignage (max 29)."

msgid "V6 — Photo hero card"
msgstr "V6 — Carte héros avec photo"

msgid "Large photo at the top of each card, dark content section below."
msgstr "Grande photo en haut de chaque carte, section sombre en dessous."

msgid "V7 — Pastel tilted cards"
msgstr "V7 — Cartes pastel inclinées"

msgid "Slightly rotated cards in pastel colors (set per testimonial)."
msgstr "Cartes légèrement inclinées en couleurs pastel (réglable par témoignage)."

msgid "V8 — Split panel hero"
msgstr "V8 — Hero divisé en panneaux"

msgid "Wide hero card: quote on the left, photo + name on the right."
msgstr "Carte héros large : citation à gauche, photo + nom à droite."

msgid "Photo on top, dark content card."
msgstr "Photo en haut, carte sombre dessous."

msgid "Slightly rotated colored cards."
msgstr "Cartes colorées légèrement inclinées."

msgid "Wide split: quote left, photo + name right."
msgstr "Division large : citation à gauche, photo + nom à droite."

msgid "V7 uses the per-testimonial background and text color from the \"V4 Highlight\" meta box on each Testimonial — set them there to give each card its own pastel color."
msgstr "V7 utilise les couleurs de fond et de texte de chaque témoignage depuis la méta \"Couleurs de carte\"."

msgid "Author box colors (V8 right panel)"
msgstr "Couleurs du bloc auteur (panneau droit V8)"

msgid "Author box background"
msgstr "Fond du bloc auteur"

msgid "Author box text color"
msgstr "Couleur du texte du bloc auteur"

msgid "Description box uses the global \"Card background\" and \"Quote / description text\" colors from the design overrides below."
msgstr "Le bloc description utilise les couleurs globales \"Fond de carte\" et \"Texte de citation/description\" des surcharges ci-dessous."

msgid "Description box colors (V8 left panel)"
msgstr "Couleurs du bloc description (panneau gauche V8)"

msgid "Description box background"
msgstr "Fond du bloc description"

msgid "Description box text color"
msgstr "Couleur du texte du bloc description"

msgid "Right column ratio: photo gets 2/3, author panel gets 1/3 vertically."
msgstr "Ratio de la colonne droite : photo 2/3, panneau auteur 1/3 (vertical)."

msgid "left description box"
msgstr "bloc description gauche"

msgid "right author box"
msgstr "bloc auteur droit"

msgid "Which testimonial to display"
msgstr "Quel témoignage afficher"

msgid "— First in selected category —"
msgstr "— Premier de la catégorie sélectionnée —"

msgid "V8 is designed to feature a single testimonial. Pick which one — leave empty to use the first from the selected category."
msgstr "V8 est conçu pour mettre en avant un seul témoignage. Choisissez lequel — laisser vide pour utiliser le premier de la catégorie."

msgid "Card colors (V4 highlight, V7 background)"
msgstr "Couleurs de carte (V4 mise en avant, V7 arrière-plan)"

msgid "Used by V4 (only when highlighted above) and V7 (always — each card uses its own background and text color)."
msgstr "Utilisé par V4 (uniquement si mis en avant) et V7 (toujours — chaque carte a son propre fond et texte)."

msgid "Style 1 — Teardrop \"66\""
msgstr "Style 1 — Goutte \"66\""

msgid "Style 2 — Bold block"
msgstr "Style 2 — Bloc gras"

msgid "Style 3 — Calligraphic comma"
msgstr "Style 3 — Virgule calligraphique"

msgid "Style 4 — Speech-bubble outline"
msgstr "Style 4 — Contour bulle"

msgid "Limit"
msgstr "Limite"

msgid "New testimonials added to this category will appear automatically."
msgstr "Les nouveaux témoignages ajoutés à cette catégorie apparaîtront automatiquement."

msgid "-1 = no limit. V5 always caps at 29."
msgstr "-1 = pas de limite. V5 toujours max 29."

