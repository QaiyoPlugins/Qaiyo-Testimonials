msgstr "Guarda la visualización primero para obtener el shortcode."

msgid "Paste this shortcode anywhere on your site:"
msgstr "Pega este shortcode en cualquier parte de tu sitio:"

msgid "Click to select, then copy."
msgstr "Haz clic para seleccionar y copiar."

msgid "1. Choose layout version"
msgstr "1. Elige la versión de diseño"

msgid "2. Quote mark style"
msgstr "2. Estilo de comillas"

msgid "3. Content source"
msgstr "3. Fuente del contenido"

msgid "4. Layout-specific options"
msgstr "4. Opciones específicas del diseño"

msgid "5. Design overrides (optional)"
msgstr "5. Anulaciones de diseño (opcional)"

msgid "V1 — Horizontal rows"
msgstr "V1 — Filas horizontales"

msgid "1 or 2 rows scrolling left/right with fading edges."
msgstr "1 o 2 filas desplazándose izquierda/derecha con bordes difuminados."

msgid "V2 — Vertical columns"
msgstr "V2 — Columnas verticales"

msgid "2 or 3 columns scrolling up/down with fading edges."
msgstr "2 o 3 columnas desplazándose arriba/abajo con bordes difuminados."

msgid "V3 — Photo carousel"
msgstr "V3 — Carrusel de fotos"

msgid "Single row, large photo on top of each card."
msgstr "Una fila, foto grande en la parte superior de cada tarjeta."

msgid "V4 — Bento grid"
msgstr "V4 — Cuadrícula bento"

msgid "Asymmetric grid with one highlighted box."
msgstr "Cuadrícula asimétrica con una caja destacada."

msgid "V5 — Avatar switcher"
msgstr "V5 — Selector de avatares"

msgid "Click an avatar to reveal the matching quote (max 29)."
msgstr "Haz clic en un avatar para ver el testimonio (máx. 29)."

msgid "V6 — Photo hero card"
msgstr "V6 — Tarjeta hero con foto"

msgid "Large photo at the top of each card, dark content section below."
msgstr "Foto grande en la parte superior de cada tarjeta, sección oscura debajo."

msgid "V7 — Pastel tilted cards"
msgstr "V7 — Tarjetas pastel inclinadas"

msgid "Slightly rotated cards in pastel colors (set per testimonial)."
msgstr "Tarjetas ligeramente rotadas en colores pastel (configurable por testimonio)."

msgid "V8 — Split panel hero"
msgstr "V8 — Hero de panel dividido"

msgid "Wide hero card: quote on the left, photo + name on the right."
msgstr "Tarjeta hero amplia: cita a la izquierda, foto + nombre a la derecha."

msgid "Photo on top, dark content card."
msgstr "Foto arriba, tarjeta de contenido oscura."

msgid "Slightly rotated colored cards."
msgstr "Tarjetas de colores ligeramente rotadas."

msgid "Wide split: quote left, photo + name right."
msgstr "División amplia: cita izquierda, foto + nombre derecha."

msgid "V7 uses the per-testimonial background and text color from the \"V4 Highlight\" meta box on each Testimonial — set them there to give each card its own pastel color."
msgstr "V7 usa los colores de fondo y texto por testimonio de la metacaja \"Colores de tarjeta\"."

msgid "Author box colors (V8 right panel)"
msgstr "Colores del cuadro de autor (panel derecho V8)"

msgid "Author box background"
msgstr "Fondo del cuadro de autor"

msgid "Author box text color"
msgstr "Color de texto del cuadro de autor"

msgid "Description box uses the global \"Card background\" and \"Quote / description text\" colors from the design overrides below."
msgstr "El cuadro de descripción usa los colores globales \"Fondo de tarjeta\" y \"Texto de cita/descripción\"."

msgid "Description box colors (V8 left panel)"
msgstr "Colores del cuadro de descripción (panel izquierdo V8)"

msgid "Description box background"
msgstr "Fondo del cuadro de descripción"

msgid "Description box text color"
msgstr "Color de texto del cuadro de descripción"

msgid "Right column ratio: photo gets 2/3, author panel gets 1/3 vertically."
msgstr "Ratio columna derecha: foto 2/3, panel de autor 1/3 (vertical)."

msgid "left description box"
msgstr "cuadro de descripción izquierdo"

msgid "right author box"
msgstr "cuadro de autor derecho"

msgid "Which testimonial to display"
msgstr "Qué testimonio mostrar"

msgid "— First in selected category —"
msgstr "— Primero de la categoría seleccionada —"

msgid "V8 is designed to feature a single testimonial. Pick which one — leave empty to use the first from the selected category."
msgstr "V8 está diseñado para destacar un solo testimonio. Elige cuál — déjalo vacío para usar el primero de la categoría."

msgid "Card colors (V4 highlight, V7 background)"
msgstr "Colores de tarjeta (V4 destacado, V7 fondo)"

msgid "Used by V4 (only when highlighted above) and V7 (always — each card uses its own background and text color)."
msgstr "Usado por V4 (solo si está destacado) y V7 (siempre — cada tarjeta tiene su propio fondo y texto)."

msgid "Style 1 — Teardrop \"66\""
msgstr "Estilo 1 — Gota \"66\""

msgid "Style 2 — Bold block"
msgstr "Estilo 2 — Bloque sólido"

msgid "Style 3 — Calligraphic comma"
msgstr "Estilo 3 — Coma caligráfica"

msgid "Style 4 — Speech-bubble outline"
msgstr "Estilo 4 — Contorno bocadillo"

msgid "Limit"
msgstr "Límite"

msgid "New testimonials added to this category will appear automatically."
msgstr "Los nuevos testimonios añadidos a esta categoría aparecerán automáticamente."

msgid "-1 = no limit. V5 always caps at 29."
msgstr "-1 = sin límite. V5 siempre máx. 29."

